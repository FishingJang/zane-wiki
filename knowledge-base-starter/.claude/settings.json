{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(mkdir *)",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(date *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(git *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ]
  }
}
